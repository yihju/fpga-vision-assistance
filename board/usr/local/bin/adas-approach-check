#!/usr/bin/env python3
"""Run the independent single-front vehicle warning check on the existing RK."""
import argparse,os,subprocess,time
from pathlib import Path

ROOT=Path('/userdata/adas_road_vehicle_20261026')


def main():
    parser=argparse.ArgumentParser(prog='adas-approach-check',description=__doc__)
    args=parser.parse_args()
    status=subprocess.run(['/usr/local/bin/adas-scene-demo','status'],capture_output=True,text=True,check=True).stdout
    if status.startswith('ADAS running'):
        subprocess.run(['/usr/local/bin/adas-scene-demo','stop'],check=True)
        until=time.monotonic()+8
        while time.monotonic()<until:
            status=subprocess.run(['/usr/local/bin/adas-scene-demo','status'],capture_output=True,text=True,check=True).stdout
            if status.startswith('ADAS stopped'):break
            time.sleep(.1)
        else:raise RuntimeError('current scene did not stop; refusing to share LED owner')
    output=ROOT/'runs'/('manual-'+str(time.time_ns()))
    # Keep the stock OPP table. This only selects the measured CPU governor.
    subprocess.run(['sudo','-n','tee','/sys/devices/system/cpu/cpufreq/policy0/scaling_governor'],
                   input='performance\n',text=True,stdout=subprocess.DEVNULL,check=True)
    print('Single front / functional600ms / GTK draw receipt / warning only',flush=True)
    print('Evidence: '+str(output),flush=True)
    command=['sudo','-n','env','DISPLAY='+os.environ.get('DISPLAY',':0'),
        'XAUTHORITY=/home/linaro/.Xauthority','PYTHONPATH=/home/linaro/plate_demo_20261015/python-deps',
        'OMP_NUM_THREADS=1','OPENBLAS_NUM_THREADS=1','python3','-B',str(ROOT/'approach_preview.py'),
        '--root',str(ROOT),'--output',str(output),'--led']
    command.append('--native-tracking')
    command.append('--exact-postprocess')
    command.append('--shared-tracking-input')
    command.append('--exact-tracking-math')
    return subprocess.call(command,cwd=ROOT)


if __name__=='__main__':raise SystemExit(main())
